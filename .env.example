# HeatLens environment — copy to .env and fill in your key(s)
# .env is gitignored; never commit actual keys.

# --- LLM provider selection ---
# Which provider to use for the chat agent.
# Supported: gemini | groq (groq is a stub until wired)
LLM_PROVIDER=gemini

# --- Google Gemini ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq ---
# Get a key at https://console.groq.com/keys
# Far faster than a large reasoning model: a two-round agent question
# measures ~1.6 s here. Set LLM_PROVIDER=groq above to use it.
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
